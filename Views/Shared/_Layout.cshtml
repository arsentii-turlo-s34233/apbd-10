<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>User Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<style>
    :root {
        --bg: #f8f4ff;
        --card: #ffffff;
        --nav: #d8c7ff;
        --nav-dark: #5d4b8c;
        --accent: #b8e0d2;
        --accent-dark: #4f8f7b;
        --pink: #ffd6e8;
        --yellow: #fff3b0;
        --text: #2f2f3a;
        --muted: #6f6f7a;
        --danger: #b84a62;
        --border: #e5ddf7;
    }

    body {
        font-family: Arial, sans-serif;
        margin: 0;
        background: linear-gradient(135deg, var(--bg), #eef8ff);
        color: var(--text);
        min-height: 100vh;
    }

    nav {
        background: var(--nav);
        padding: 14px 28px;
        display: flex;
        gap: 18px;
        align-items: center;
        box-shadow: 0 4px 18px rgba(93, 75, 140, 0.15);
    }

    nav a,
    nav button {
        color: var(--nav-dark);
        text-decoration: none;
        background: transparent;
        border: none;
        font-size: 16px;
        cursor: pointer;
        padding: 8px 12px;
        border-radius: 999px;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    nav a:hover,
    nav button:hover {
        background: rgba(255, 255, 255, 0.55);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .brand {
        font-weight: bold;
        background: rgba(255, 255, 255, 0.7);
        margin-right: 20px;
    }

    .container {
        max-width: 900px;
        margin: 36px auto;
        background: var(--card);
        padding: 30px;
        border-radius: 22px;
        border: 1px solid var(--border);
        box-shadow: 0 12px 35px rgba(93, 75, 140, 0.12);
    }

    h1, h2, h3, h4, h5 {
        color: var(--nav-dark);
    }

    input,
    textarea {
        display: block;
        width: 100%;
        max-width: 430px;
        padding: 11px 13px;
        margin-top: 6px;
        margin-bottom: 14px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: #fffaff;
        color: var(--text);
        font-size: 15px;
        outline: none;
    }

    input:focus,
    textarea:focus {
        border-color: var(--nav);
        box-shadow: 0 0 0 4px rgba(216, 199, 255, 0.35);
    }

    label {
        font-weight: 600;
        color: var(--muted);
    }

    button,
    .btn {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 999px;
        border: none;
        background: var(--accent);
        color: #28594c;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    button:hover,
    .btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(79, 143, 123, 0.22);
    }

    .btn-primary {
        background: var(--accent);
        color: #28594c;
    }

    .text-danger {
        color: var(--danger);
        font-size: 14px;
    }

    .card {
        background: linear-gradient(135deg, #ffffff, #fff7fb);
        border: 1px solid var(--border);
        padding: 16px;
        margin-bottom: 14px;
        border-radius: 18px;
        box-shadow: 0 6px 18px rgba(93, 75, 140, 0.08);
    }

    .card-body {
        padding: 4px;
    }

    small {
        color: var(--muted);
    }

    a {
        color: var(--accent-dark);
    }

    form {
        margin: 0;
    }

    .mb-3 {
        margin-bottom: 18px;
    }

    .mb-2 {
        margin-bottom: 12px;
    }
</style>
</head>
<body>
<nav>
    <a class="brand" asp-controller="Home" asp-action="Index">User Panel</a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index">Admin</a>
        }

        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit">Logout</button>
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Register">Register</a>
        <a asp-controller="Account" asp-action="Login">Login</a>
    }
</nav>

<div class="container">
    @RenderBody()
</div>
</body>
</html>